{
  "cli": {
    "version": ">= 24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "preview-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "release-apk": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "production"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
